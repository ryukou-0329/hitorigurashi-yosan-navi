---
import type { Crumb } from '../lib/seo';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="パンくずリスト">
  <ol>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1
          ? <span aria-current="page">{c.name}</span>
          : <a href={c.path}>{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
