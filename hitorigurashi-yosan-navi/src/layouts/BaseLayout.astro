---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbLd, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, path, breadcrumbs = [], jsonLd = [], noindex } = Astro.props;
const ld = [...jsonLd];
if (breadcrumbs.length > 1) ld.push(breadcrumbLd(breadcrumbs, Astro.site));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead title={title} description={description} path={path} jsonLd={ld} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <div class="wrap">
        {breadcrumbs.length > 1 && <Breadcrumb items={breadcrumbs} />}
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
